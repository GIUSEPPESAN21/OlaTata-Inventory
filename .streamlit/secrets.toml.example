# Copia este archivo a .streamlit/secrets.toml y rellena los valores reales.
# .streamlit/secrets.toml NUNCA se sube al repositorio (ver .gitignore).
#
# Cómo crear el token (fine-grained PAT): ver DEPLOY.md, sección "Crear el token".

GITHUB_TOKEN = "github_pat_xxx..."

# Repositorio de datos vivos (mes en curso)
GITHUB_REPO = "GIUSEPPESAN21/OlaTata-Database"

# Repositorio de archivo (meses cerrados)
GITHUB_REPO_ARCHIVE = "GIUSEPPESAN21/OlaTata-Archive"
